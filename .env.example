# --- control plane ---
ASM_DATABASE_URL=postgres://asm:asm@localhost:5432/asm?sslmode=disable
ASM_API_ADDR=:8080
ASM_GATEWAY_ADDR=:8090
ASM_PUBLIC_GATEWAY_URL=https://gw.asm.example.com

# Shared secret local worker containers use to self-enroll. Change it.
# Only accepted from private source addresses, so a leak cannot mint an
# auto-approved internal-scanning worker from the internet.
ASM_LOCAL_BOOTSTRAP_TOKEN=change-me-local-bootstrap

# Shared secret between api and the provisioner sidecar (the only container
# holding the Docker socket). Change it. Remove the provisioner service from
# docker-compose.yml if you would rather scale workers from the CLI.
ASM_PROVISIONER_TOKEN=change-me-provisioner

# GID that owns /var/run/docker.sock, so the non-root provisioner can open it.
# Find it with:  stat -c %g /var/run/docker.sock
ASM_DOCKER_GID=999

# --- object storage (S3/MinIO) ---
ASM_S3_ENDPOINT=http://localhost:9000
ASM_S3_BUCKET=asm-artifacts
ASM_S3_ACCESS_KEY=minioadmin
ASM_S3_SECRET_KEY=minioadmin
ASM_S3_REGION=us-east-1

# --- passive discovery API keys -------------------------------------------
# Fill in whichever you have; every one is optional and blank keys are skipped.
# More keys = more subdomains found without sending a single packet to the target.
# The worker turns these into subfinder's provider-config.yaml at startup.

# DNSDumpster
DNSDUMPSTER_API_KEY=

# Large infrastructure indexes
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
SECURITYTRAILS_API_KEY=
NETLAS_API_KEY=
ZOOMEYE_API_KEY=
QUAKE_API_KEY=
FOFA_EMAIL=
FOFA_API_KEY=
HUNTER_API_KEY=
BINARYEDGE_API_KEY=
LEAKIX_API_KEY=

# Certificate / reputation / misc sources
VIRUSTOTAL_API_KEY=
WHOISXMLAPI_API_KEY=
BEVIGIL_API_KEY=
INTELX_HOST=
INTELX_API_KEY=
CHAOS_API_KEY=
GITHUB_TOKEN=

# --- worker (set on the VPS by install.sh) ---
ASM_GATEWAY_URL=https://gw.asm.example.com
ASM_WORKER_CREDENTIAL_FILE=/etc/pinkglasses-worker/credential
ASM_WORKER_NAME=local
ASM_WORKER_MAX_CONCURRENCY=8

# Worker log detail: debug | info | warn | error.
# info logs every tool invocation and stage summary; debug adds each individual
# finding (candidate names, open ports, discovered paths).
ASM_LOG_LEVEL=info

# Seals VPN configurations at rest (AES-256-GCM). Generate one with:
#   openssl rand -base64 32
# Without it, VPN configs cannot be stored — nothing else is affected. Changing
# it makes existing configs unreadable, so treat it like a database password.
# The api, the gateway AND the scheduler all need it: the scheduler opens the
# config to hand it to a run's VPN gateway container.
ASM_SECRET_KEY=

# How many runs may hold containers of their own at once. A run that scans
# through a VPN brings up a gateway container plus its own workers and destroys
# them when it ends (architecture.md §7.6); this bounds how many such sets can
# exist on the host together. A run arriving over the limit fails with the
# reason rather than queueing, because its tasks are bound to a pool that would
# have no members.
ASM_MAX_RUN_FLEETS=3

# Optional: let a reverse proxy assert who the user is.
#
# Set this and the proxy must send BOTH X-Forwarded-User and a matching
# X-Proxy-Secret; the header alone is refused, because it is a request header
# and anything able to reach the API could set it. Leave it empty and header
# authentication is off entirely, which is the default and the safe choice.
#
#   ASM_TRUSTED_PROXY_SECRET=$(openssl rand -base64 32)
ASM_TRUSTED_PROXY_SECRET=
