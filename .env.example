# --- control plane ---
ASM_DATABASE_URL=postgres://asm:asm@localhost:5432/asm?sslmode=disable
ASM_API_ADDR=:8080
ASM_GATEWAY_ADDR=:8090
ASM_PUBLIC_GATEWAY_URL=https://gw.asm.example.com

# Shared secret local worker containers use to self-enroll. Change it.
# Only accepted from private source addresses, so a leak cannot mint an
# auto-approved internal-scanning worker from the internet.
ASM_LOCAL_BOOTSTRAP_TOKEN=change-me-local-bootstrap

# Shared secret between api and the provisioner sidecar (the only container
# holding the Docker socket). Change it. Remove the provisioner service from
# docker-compose.yml if you would rather scale workers from the CLI.
ASM_PROVISIONER_TOKEN=change-me-provisioner

# GID that owns /var/run/docker.sock, so the non-root provisioner can open it.
# Find it with:  stat -c %g /var/run/docker.sock
ASM_DOCKER_GID=999

# --- object storage (S3/MinIO) ---
ASM_S3_ENDPOINT=http://localhost:9000
ASM_S3_BUCKET=asm-artifacts
ASM_S3_ACCESS_KEY=minioadmin
ASM_S3_SECRET_KEY=minioadmin
ASM_S3_REGION=us-east-1

# --- passive discovery API keys -------------------------------------------
#
# Every source subfinder v2.16 accepts a credential for. All optional: blanks
# are skipped and the source is simply not queried. More keys means more
# subdomains found without sending a single packet at the target.
#
# Paste values with nothing after them. A `.env` file has no inline comments —
# `SHODAN_API_KEY=abc123  # my key` sets the key to "abc123  # my key", which
# the provider will reject.
#
# The worker renders these into subfinder's provider-config.yaml at startup and
# logs which sources came up configured. Keys live only here (git-ignored) and
# in the worker's environment: never in the database, never in the UI, never in
# a log. If you upgrade subfinder and it renames or drops a source, the worker
# says so at startup rather than ignoring your key in silence.
#
# Needs no key, always used: anubis, commoncrawl, crtsh, digitorus, hudsonrock,
# rapiddns, scanmalware, shodanct, sitedossier, thc, threatcrowd, waybackarchive.

# Certificate transparency and DNS history
CERTSPOTTER_API_KEY=
DNSDB_API_KEY=
DNSDUMPSTER_API_KEY=
DNSREPO_API_KEY=
MERKLEMAP_API_KEY=
SECURITYTRAILS_API_KEY=
WHOISXMLAPI_API_KEY=

# Internet-wide scan indexes.
# Censys and FOFA take two parts; the worker joins them the way subfinder wants
# (ID:SECRET and EMAIL:KEY). Set both halves or neither — half is ignored.
CENSYS_API_ID=
CENSYS_API_SECRET=
FOFA_EMAIL=
FOFA_API_KEY=
FULLHUNT_API_KEY=
NETLAS_API_KEY=
ONYPHE_API_KEY=
QUAKE_API_KEY=
SHODAN_API_KEY=
# ZoomEye: subfinder calls this source "zoomeyeapi".
ZOOMEYE_API_KEY=

# Threat intelligence and reputation
ALIENVAULT_API_KEY=
LEAKIX_API_KEY=
THREATBOOK_API_KEY=
URLSCAN_API_KEY=
VIRUSTOTAL_API_KEY=

# Recon platforms and aggregators.
# Hackertarget, reconeer and submd work without a key and return more with one.
# IntelX takes two parts, joined as HOST:KEY — its host looks like "2.intelx.io".
BEVIGIL_API_KEY=
BUFFEROVER_API_KEY=
BUILTWITH_API_KEY=
C99_API_KEY=
CHAOS_API_KEY=
CHINAZ_API_KEY=
DIGITALYAMA_API_KEY=
DOMAINSPROJECT_API_KEY=
DRIFTNET_API_KEY=
HACKERTARGET_API_KEY=
INTELX_HOST=
INTELX_API_KEY=
PROFUNDIS_API_KEY=
PUGRECON_API_KEY=
RECONEER_API_KEY=
REDHUNTLABS_API_KEY=
ROBTEX_API_KEY=
RSECLOUD_API_KEY=
SUBMD_API_KEY=
WINDVANE_API_KEY=

# Code search. A classic GitHub PAT with no scopes is enough.
GITHUB_TOKEN=

# --- worker (set on the VPS by install.sh) ---
ASM_GATEWAY_URL=https://gw.asm.example.com
ASM_WORKER_CREDENTIAL_FILE=/etc/pinkglasses-worker/credential
ASM_WORKER_NAME=local
ASM_WORKER_MAX_CONCURRENCY=8

# Worker log detail: debug | info | warn | error.
# info logs every tool invocation and stage summary; debug adds each individual
# finding (candidate names, open ports, discovered paths).
ASM_LOG_LEVEL=info

# Seals VPN configurations at rest (AES-256-GCM). Generate one with:
#   openssl rand -base64 32
# Without it, VPN configs cannot be stored — nothing else is affected. Changing
# it makes existing configs unreadable, so treat it like a database password.
# The api, the gateway AND the scheduler all need it: the scheduler opens the
# config to hand it to a run's VPN gateway container.
ASM_SECRET_KEY=

# How many runs may hold containers of their own at once. A run that scans
# through a VPN brings up a gateway container plus its own workers and destroys
# them when it ends (architecture.md §7.6); this bounds how many such sets can
# exist on the host together. A run arriving over the limit fails with the
# reason rather than queueing, because its tasks are bound to a pool that would
# have no members.
ASM_MAX_RUN_FLEETS=3

# Optional: let a reverse proxy assert who the user is.
#
# Set this and the proxy must send BOTH X-Forwarded-User and a matching
# X-Proxy-Secret; the header alone is refused, because it is a request header
# and anything able to reach the API could set it. Leave it empty and header
# authentication is off entirely, which is the default and the safe choice.
#
#   ASM_TRUSTED_PROXY_SECRET=$(openssl rand -base64 32)
ASM_TRUSTED_PROXY_SECRET=

# The password of the `admin` account created on first boot.
#
# Unset, a fresh install starts with the published default (`pinkglasses`), and
# both the UI and the startup log nag until it is changed. Set this before the
# first boot to start with something that was never in a README:
#
#   ASM_DEFAULT_ADMIN_PASSWORD=$(openssl rand -base64 24)
#
# Set it to "-" to create no account at all; the first visit then asks you to
# create an administrator. Changing this later does nothing — the account is
# only ever created on an empty database.
ASM_DEFAULT_ADMIN_PASSWORD=

# Optional proxy for passive stages (subfinder's API calls). Passive stages
# never send a packet at the target — they talk to third-party APIs — so this is
# about not presenting this host's address to forty providers, not about the
# scan. http:// or socks5://. DNS stages (dnsx, shuffledns) speak UDP and cannot
# use it. Active stages never see this: they leave through the run's VPN gateway
# or its remote pool.
ASM_PASSIVE_PROXY=
